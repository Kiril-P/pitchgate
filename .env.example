# Copy to .env and fill in; docker compose reads it. .env is git-ignored: never commit real values.

# Local SQL Server container. Passwords need 8+ characters with upper case, lower case, a digit and a symbol.
# They go into connection URLs, so avoid @ : / ? # in them (or URL-encode those characters).
MSSQL_SA_PASSWORD=
IDEAS_DB_PASSWORD=
REVIEW_DB_PASSWORD=

# Jev (Typesafe) scores each revision and each tasting gate. Without it, verdicts stay PENDING.
TYPESAFE_API_KEY=
# Most successful Jev calls one idea may make. Failed calls don't count.
# JEV_BUDGET_PER_IDEA=15

# Chef talks to any OpenAI-compatible chat endpoint. Default: Google Gemini.
# Use a paid tier for real cohorts: Google may use free-tier content to improve its products.
COACH_API_KEY=
# Comma-separated: tried in order when one is busy.
# COACH_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# COACH_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Key for the organizer view. Empty turns it off.
# ORGANIZER_KEY=
