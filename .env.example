# Copy to .env and fill in. .env is git-ignored.
# Real environment variables override anything in this file.

# Jev (Typesafe) scores each revision. Without it, verdicts stay PENDING.
TYPESAFE_API_KEY=

# Chef talks to any OpenAI-compatible chat endpoint. Default: Google Gemini.
# Free key: https://aistudio.google.com/apikey
COACH_API_KEY=
# Comma-separated: tried in order when one is busy.
# COACH_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# COACH_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# To use OpenAI instead:
# COACH_URL=https://api.openai.com/v1/chat/completions
# COACH_MODEL=gpt-4.1-mini

# PORT=5000
# DATA_DIR=data
